# Required
AIRBRAKE_PROJECT_ID=
AIRBRAKE_PROJECT_KEY=
REPO_DIR=/path/to/a/clone/of/your/app
SINCE_MINUTES=30

# Optional
BASE_BRANCH=main
MODE=new_errors
INSIGHTS_WINDOW_MINUTES=1440
ECHO=true
AUTO_FIX_PRS=false
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
PRODUCT_LABELS_JSON=

# Models (aliases or full ids accepted by the claude CLI)
CLASSIFIER_MODEL=sonnet
FIXER_MODEL=sonnet
